{
  "name": "l9-seo-bot",
  "version": "2.1.0",
  "type": "module",
  "description": "L9 Autonomous SEO Maintenance Bot with persistent router budgets and governed Graphiti memory",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest",
    "migrate": "tsx src/core/database/migrate.ts",
    "seed": "tsx src/core/database/seed.ts",
    "add-client": "tsx scripts/add-client.ts",
    "request-site-build": "tsx scripts/request-site-build.ts",
    "verify:preflight": "tsx -e \"require('./src/core/config.ts')\"",
    "verify:source": "test -f src/index.ts && test -f src/core/config.ts",
    "verify:build": "npm run build && test -f dist/index.js",
    "verify:db": "tsx src/core/database/migrate.ts --check",
    "verify:all": "npm run verify:preflight && npm run verify:source && npm run verify:build && npm test",
    "typecheck": "tsc -p tsconfig.check.json --noEmit",
    "manifest:generate": "tsx scripts/manifest/generate.ts",
    "manifest:check": "tsx scripts/manifest/check.ts",
    "verify:assurance": "tsx scripts/validation/cli.ts run --profile ci",
    "verify:release": "tsx scripts/validation/cli.ts run --profile release",
    "verify:production": "tsx scripts/validation/cli.ts run --profile production",
    "evidence:clean": "tsx scripts/validation/cli.ts clean",
    "lockfile:generate": "npm install --package-lock-only --ignore-scripts --no-audit --no-fund"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.0",
    "@fastify/formbody": "^7.4.0",
    "@fastify/helmet": "^11.1.1",
    "@quantum-l9/bot-interop": "file:packages/bot-interop",
    "@quantum-l9/graphiti-memory-client": "file:packages/graphiti-memory-client",
    "@quantum-l9/infisical-config": "git+https://github.com/Quantum-L9/infisical-config.git#331ef590a73dd208e705d99a1f5137fa094de910",
    "@quantum-l9/llm-router": "git+https://github.com/Quantum-L9/LLM-Router.git#v1.3.0",
    "axios": "^1.7.0",
    "bullmq": "^5.0.0",
    "cheerio": "^1.0.0",
    "cron": "^3.1.0",
    "dotenv": "^16.4.0",
    "drizzle-orm": "^0.36.0",
    "fastify": "^4.28.0",
    "ioredis": "^5.4.0",
    "nodemailer": "^6.9.0",
    "openai": "^4.70.0",
    "pg": "^8.22.0",
    "pino": "^9.5.0",
    "pino-pretty": "^11.3.0",
    "posthog-node": "^4.3.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^6.4.0",
    "@types/pg": "^8.21.0",
    "drizzle-kit": "^0.28.1",
    "eslint": "^9.0.0",
    "globals": "^15.14.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.64.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "overrides": {
    "@quantum-l9/graphiti-memory-client": "file:packages/graphiti-memory-client"
  }
}

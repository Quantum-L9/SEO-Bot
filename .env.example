# ═══════════════════════════════════════════════════════════════════════════════
# L9 SEO BOT - Environment Configuration (v2.0 — @quantum-l9/llm-router powered)
# Copy this file to .env and fill in your values
# ═══════════════════════════════════════════════════════════════════════════════

# ─── Infisical (optional secret manager) ─────────────────────────────────────
# When these machine-identity (Universal Auth) vars are set, the bot pulls all
# of the secrets below from Infisical at startup and backfills process.env —
# so a VPS deploy needs no committed .env. Leave them blank to use this file as
# usual. Anything already set in the environment is NEVER overwritten by
# Infisical, so the keys below still win for local dev / one-off overrides.
INFISICAL_CLIENT_ID=
INFISICAL_CLIENT_SECRET=
INFISICAL_PROJECT_ID=
INFISICAL_ENV=prod
INFISICAL_SECRET_PATH=/
# INFISICAL_SITE_URL=https://app.infisical.com   # set for a self-hosted instance
# INFISICAL_RECURSIVE=false                       # pull nested folders too
# INFISICAL_REQUIRED=false                        # true = abort boot if the load fails

# ─── Database ─────────────────────────────────────────────────────────────────
POSTGRES_USER=l9admin
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=l9_seo_bot
DATABASE_URL=postgres://l9admin:CHANGE_ME_STRONG_PASSWORD@postgres:5432/l9_seo_bot

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ─── ClickHouse (PostHog) ─────────────────────────────────────────────────────
CLICKHOUSE_USER=posthog
CLICKHOUSE_PASSWORD=CHANGE_ME_CLICKHOUSE_PASSWORD

# ─── PostHog ──────────────────────────────────────────────────────────────────
POSTHOG_SECRET_KEY=CHANGE_ME_RANDOM_SECRET_KEY
POSTHOG_SITE_URL=http://your-server-ip:8000
POSTHOG_API_URL=http://posthog:8000
POSTHOG_PERSONAL_API_KEY=phx_YOUR_POSTHOG_PERSONAL_API_KEY

# ─── DataForSEO (SERP Intelligence + Backlinks) ──────────────────────────────
DATAFORSEO_LOGIN=your_dataforseo_login
DATAFORSEO_PASSWORD=your_dataforseo_password
# Per-request HTTP timeout in ms. Positive integer; defaults to 90000 —
# the live SERP endpoint needs more than 30s under load.
DATAFORSEO_TIMEOUT_MS=90000

# ─── Google APIs ──────────────────────────────────────────────────────────────
GOOGLE_SERVICE_ACCOUNT_JSON=./config/google-service-account.json
GOOGLE_SEARCH_CONSOLE_SITE_URL=https://your-site.com

# ─── PageSpeed Insights ───────────────────────────────────────────────────────
PAGESPEED_API_KEY=your_google_pagespeed_api_key

# ─── LLM — @quantum-l9/llm-router (Multi-Provider, Task-Based Routing) ──────────────
# Two API keys give you access to ALL models:
#   OpenRouter → GPT-4o, GPT-4o-mini, Claude Sonnet/Opus/Haiku, Gemini Flash/Pro, O1, O3
#   Perplexity → Sonar, Sonar Pro, Sonar Reasoning, Sonar Deep Research
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_key
PERPLEXITY_API_KEY=pplx-your_perplexity_key

# ─── Cross-repo handoff auth ─────────────────────────────────────────────────
# Shared secret the Website Factory presents (Bearer token) to
# POST /api/clients/register. Must equal Website-Bot's SEO_BOT_API_KEY.
# REQUIRED: when unset, /api/clients/register fails closed (503).
SEO_BOT_API_KEY=

# ─── Operator API / dashboard auth ───────────────────────────────────────────
# Shared secret required to reach the operator dashboard and API (all routes
# except /health and /api/clients/register). Present it as HTTP Basic (any
# username, this value as the password — browsers show a login prompt) or as a
# Bearer token. REQUIRED: when unset, the operator API is locked (401).
OPERATOR_API_KEY=
# Optional comma-separated CORS allow-list for the operator API. Unset = CORS
# disabled (same-origin only), the safe default.
DASHBOARD_ALLOWED_ORIGINS=

# ─── Reporting SQL plane (ADR-0015) ──────────────────────────────────────────
# /api/reporting/* serves named, allow-listed queries over the `reporting`
# schema. Two audiences, two secrets — the CREDENTIAL chooses the audience, not
# the request:
#
#   OPERATOR_API_KEY         → operator audience. Sees client names, domains,
#                              and contact details.
#   REPORTING_AGENT_API_KEY  → agent audience. Masked projections only: never a
#                              client name, domain, contact email, or credential.
#
# The agent surface is OPT-IN. Leave this unset and agents have no access at
# all. It must be a DIFFERENT secret from OPERATOR_API_KEY — startup fails if
# they match, because the operator key is checked first and a shared secret
# would silently hand an agent the operator projections.
REPORTING_AGENT_API_KEY=

# ─── Intelligence plane (ADR-0016) ───────────────────────────────────────────
# The bot's own reasoning loop. All defaults are conservative and need no
# configuration; every value below is a bound on autonomy, not a feature switch.
#
# Minimum opportunity score eligible to become an action proposal. Raise it to
# make the bot more selective without disabling reasoning; everything below the
# bar is still recorded for the operator.
INTELLIGENCE_MIN_OPPORTUNITY_SCORE=20
# Hard ceiling on proposals per client per run. 0 stops proposals entirely while
# leaving observation, diagnosis, and measurement running.
INTELLIGENCE_MAX_ACTIONS_PER_RUN=3
# Days a signal fingerprint stays suppressed after being observed, so an
# unchanged problem does not refill the approval queue every cycle. CRITICAL
# findings are never suppressed.
INTELLIGENCE_SIGNAL_COOLDOWN_DAYS=7
# Days an opportunity may sit without the underlying problem recurring before it
# expires. MUST exceed INTELLIGENCE_SIGNAL_COOLDOWN_DAYS — inside the cooldown a
# still-real problem produces no new signal, so a shorter window would expire
# every opportunity for want of evidence it was suppressing. Asserted at startup.
INTELLIGENCE_OPPORTUNITY_EXPIRY_DAYS=30
# Proposals the synthesis sweep ranks per pass. This is the only step that spends
# tokens, so it is also the per-pass spend bound.
INTELLIGENCE_SYNTHESIS_BATCH_SIZE=10
# Attribution windows: how long before and after an executed action is measured
# before "did it work?" is answered. Shorter windows measure noise.
INTELLIGENCE_BASELINE_DAYS=14
INTELLIGENCE_MEASUREMENT_DAYS=28
#
# ─── Rollout ladder ──────────────────────────────────────────────────────────
# How far around the loop the plane may get. Each rung is a superset of the one
# before it, so this is raised one step at a time and lowered in one step:
#
#   off        installed and inert
#   observe    records signals and opportunities; proposes nothing
#   recommend  writes proposals and decisions; queues nothing
#   route_safe queues non-outreach follow-up jobs and opens measurement windows
#   route_llm  + the model may RANK remedies a pack already permits
#   full       the top of the ladder — see the two flags below for what it does
#              NOT grant
#
# Defaults to `off`. Start a production cutover at `observe` and let it sit long
# enough to read what the bot would have done before granting it the right to
# act. Rollback is this one value plus a restart — no code change, no migration.
INTELLIGENCE_MODE=observe
# Out-of-ladder capabilities. Both are irreversible, so NO mode grants either on
# its own: each needs the routing rung AND its own flag. Raising the mode to
# `full` for better ranking must not also authorize mail to a third party.
#
# Queue the outreach follow-up job, which sends mail to third parties.
INTELLIGENCE_ALLOW_OUTREACH_ROUTING=false
# Queue work that writes to a client's live site. The live-write job is also
# excluded from the scheduler's TRIGGERABLE_JOBS allow-list; this is the second
# lock, not a replacement for the first. Keep SITE_DEPLOY_DRY_RUN=true as well.
INTELLIGENCE_ALLOW_SITE_MUTATION=false
# The plane's only token-spending step. Unset or `false` stops all spend
# regardless of mode; it can never be re-enabled as a side effect of a mode
# change. Note the shape: only "true"/"1" enable it, so `=false` really is off.
INTELLIGENCE_LLM_PLANNING_ENABLED=false

# ─── Budget — Surge-Aware Model ──────────────────────────────────────────────
# The router downgrades models when budget is tight — it NEVER kills a task.
# Per-client monthly budget (dollars)
DEFAULT_CLIENT_MONTHLY_BUDGET=200.00
# Weekly soft target (Mon-Fri normal operations)
DEFAULT_CLIENT_WEEKLY_TARGET=50.00
# Weekly hard ceiling (safety net — allows surge if week was quiet)
DEFAULT_CLIENT_WEEKLY_CEILING=100.00
# Global hard ceiling across ALL clients (monthly)
GLOBAL_MONTHLY_HARD_CEILING=2000.00
# Surge threshold: if week spend < this % of target by Thursday, allow burst
SURGE_THRESHOLD=0.6
# Optional hard daily LLM spend cap in USD; unset means no daily tier.
DAILY_SPEND_CAP=

# ─── Execution Policy ────────────────────────────────────────────────────────
# Maximum autonomy: only 'critical' actions require approval.
# Options: 'critical' (max autonomy) | 'high' (high+irreversible also queues)
REQUIRE_APPROVAL_ONLY_FOR=critical
AUTO_EXECUTE_THRESHOLD=high

# ─── Site Deployment Transport (C-01 / GAP-08) ───────────────────────────────
# Required only when the 'serp:execute-surpass-plans' job is enabled (it edits
# the live Astro site via the GitHub Contents API + a Vercel deploy hook).
# GITHUB_TOKEN here is a PAT with repo:write on the Website-Bot source repo
# (distinct from the Actions GITHUB_TOKEN). Set NODE_ENV=test or
# SITE_DEPLOY_DRY_RUN=true to log mutations without writing.
GITHUB_TOKEN=
VERCEL_DEPLOY_HOOK=
WEBSITE_BOT_REPO=Quantum-L9/Website-Bot
SITE_SOURCE_BRANCH=main
SITE_DEPLOY_DRY_RUN=false

# Per-client credential values referenced by env://NAME in the enriched v2 handoff.
# When a client registers with the enriched `site` block, SEO-Bot stores only the
# env:// reference names (never raw secrets); Infisical/env hydrates the values
# here at boot so maintenance readiness and per-tenant deploys can resolve them.
CLIENT_SITE_GITHUB_TOKEN=
CLIENT_SITE_VERCEL_DEPLOY_HOOK=

# ─── Email Outreach ──────────────────────────────────────────────────────────
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=your_sendgrid_api_key
OUTREACH_FROM_EMAIL=outreach@yourdomain.com
OUTREACH_FROM_NAME=Your Agency Name

# ─── Hunter.io (Email Discovery) ─────────────────────────────────────────────
HUNTER_API_KEY=your_hunter_io_api_key

# ─── Citation Services ────────────────────────────────────────────────────────
BRIGHTLOCAL_API_KEY=your_brightlocal_api_key

# ─── Bot Configuration ────────────────────────────────────────────────────────
BOT_PORT=3100
BOT_LOG_LEVEL=info
BOT_TIMEZONE=America/New_York
# Set true when the API is behind a reverse proxy / tunnel (Caddy/nginx/
# Cloudflare) so request.ip and the per-IP rate limiter use X-Forwarded-For.
# Leave false when the API is directly exposed (avoids XFF spoofing).
TRUST_PROXY=false

# ─── Operator Notifications ───────────────────────────────────────────────────
# Weekly report: TO = domain owner (from client config), CC = operator
OPERATOR_EMAIL=you@yourdomain.com
OPERATOR_CC_EMAIL=ib@quantumaipartners.com
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# Governed cross-agent memory. Required.
# Blank L9_MEMORY_TOKEN aliases GRAPHITI_MCP_TOKEN from Infisical or
# ~/.cursor/graphiti.env. Do not invent a token.
L9_MEMORY_MODE=required
L9_MEMORY_URL=http://127.0.0.1:8100
L9_MEMORY_TOKEN=
L9_MEMORY_TOKEN_BUDGET=1200
L9_MEMORY_MAX_RECORDS=40
